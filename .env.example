# ---------------------------------------------------------------------------
# TellaTale — copy to .env and fill in. .env is gitignored; this file is not.
#
# With NONE of these set the app still runs, in local mode: the full owner flow
# against on-device storage with deterministic composition. Cross-device guest
# contribution is the one thing that genuinely needs the backend.
# ---------------------------------------------------------------------------

# --- Supabase (client) -----------------------------------------------------
# Dashboard -> Project Settings -> API.
#
# The publishable key is a public identifier, not a secret: access is decided by
# Row Level Security, not by hiding this string. The SERVICE ROLE key is a
# different thing entirely and must never appear here or in any EXPO_PUBLIC_
# variable — anything with that prefix is compiled into the app bundle and is
# readable by anyone who downloads it.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Deep links ------------------------------------------------------------
# The domain serving App Links / Universal Links and the guest landing page.
# Until this points at a real host, invite links fall back to the app scheme and
# only open on a device that already has TellaTale installed. Must also be
# reflected in app.json.
EXPO_PUBLIC_LINK_HOST=

# --- Local overrides -------------------------------------------------------
# Force the on-device adapter even when Supabase is configured. Useful for
# demoing on a network you do not trust.
EXPO_PUBLIC_FORCE_LOCAL=false


# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY — set with `npx supabase secrets set`, never in this file
# and never with an EXPO_PUBLIC_ prefix.
# ---------------------------------------------------------------------------
#
#   STORYIMAGE_COMPOSER_URL    Your existing StoryImage composer endpoint. It
#                              receives a ComposeRequest (see shared/story.ts)
#                              and must return the ComposedStory shape.
#                              Unset -> deterministic local composition.
#   STORYIMAGE_COMPOSER_TOKEN  Optional bearer token for that endpoint.
#   FIREBASE_SERVICE_ACCOUNT   The Firebase service account JSON, as one string.
#                              Used only to sign FCM push. Unset -> no push.
